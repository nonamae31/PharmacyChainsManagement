        <mxCell id="m6" value="6: Inventories.Where(b =&amp;gt; b.BranchId == branchId).Include(Medicine).Include(Batch)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
