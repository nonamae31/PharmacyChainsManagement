        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;endFill=0;endSize=14;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="service" target="iservice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. Association from InventoryService to PharmacyDbContext -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=12;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="service" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. Composition from PharmacyDbContext to Stocktake -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="repo" target="entity_st">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. Composition from PharmacyDbContext to InventoryAdjustment -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="repo" target="entity_adj">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="960" />
              <mxPoint x="1410" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
