        <!-- 8. Association from InventoryService to PharmacyDbContext -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=12;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="service" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. Composition from PharmacyDbContext to Inventory -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="repo" target="entity_inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. Composition from PharmacyDbContext to Medicine -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="repo" target="entity_med">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
